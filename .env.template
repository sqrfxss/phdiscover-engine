# ─────────────────────────────────────────────────────────────
# PhDiscover Engine — Environment Configuration
# Copy to .env and fill in. NEVER commit the filled .env.
# ─────────────────────────────────────────────────────────────

# ── Email (pick AT LEAST one) ────────────────────────────────
# All four verified reachable from Iran on 2026-09-29.
# Mailchimp is NOT reachable (503) — do not use it.

# Resend — 3,000 emails/month free. Best deliverability. (Recommended)
# https://resend.com → API Keys → Create
RESEND_API_KEY=
EMAIL_FROM=positions@yourdomain.com
EMAIL_REPLY_TO=

# Brevo — 300 emails/day free. Good fallback.
# https://brevo.com → Settings → SMTP & API → API Keys
BREVO_API_KEY=

# Direct SMTP — relays from a mailbox you already own, no third party.
# Gmail needs an App Password (requires 2FA on).
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# ── Site ─────────────────────────────────────────────────────
SITE_URL=https://phdiscover.pages.dev

# ── API (optional) ───────────────────────────────────────────
# Host a small endpoint (Cloudflare Worker / free tier) and the subscribe form
# will POST to it instead of storing locally in the browser. Blank = local mode.
PHDISCOVER_API_URL=

# ── Telegram (blocked from Iran, reference only) ─────────────
# api.telegram.org is unreachable from Iranian networks (httpx.ConnectError).
# Only works when the bot runs outside Iran (GitHub Actions, VPS).
TELEGRAM_BOT_TOKEN=8982006321:AAFlHmfz8hYXF8ZHD3jkUvbMEQAsmPYo5Jk
TELEGRAM_CHANNEL_ID=

# ── Database (optional for MVP) ───────────────────────────────
# Site + email work without a database. Add one when you need user accounts.
# Supabase (500 MB free): https://supabase.com → New Project → Settings → Database
DATABASE_URL=
REDIS_URL=

# ── Search (optional) ────────────────────────────────────────
# OpenAlex needs no key. Adding an email raises your rate-limit tier.
OPENALEX_EMAIL=saeidsoraghi6@gmail.com
EXA_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# ── Crawl behaviour ──────────────────────────────────────────
CRAWL_MAX_RESULTS=50
CRAWL_MAX_PAGES=4

# ── Deploy (optional) ────────────────────────────────────────
RAILWAY_TOKEN=
RENDER_API_KEY=

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json