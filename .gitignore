.secrets

# Logs
logs/
*.log

# Database
*.sqlite
*.db
# Crawl output is large and regenerable; the site's copy of it is the one that
# must ship, because a GitHub Pages deploy reads straight from the repo.
data/
!web/data/
web/data/*.tmp

# Newsletter subscriber list is personal data — never commit it.
data/subscribers.json
data/email_log.jsonl

